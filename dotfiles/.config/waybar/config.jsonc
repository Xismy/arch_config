{
	"exclusive": true,
	"margin-top": 5,
	"margin-left": 50,
	"margin-right": 50,
	"layer": "top",

	"modules-left": [
		"niri/workspaces",
	],
	"modules-center": [
		"niri/window",
	],
	"modules-right": [
		"group/audio_source",
		"group/audio_sink",
		"keyboard-state",
		"network",
		"clock",
		"tray",
		"custom/power-menu",
	],	
	"clock": {
		"format": "{:%H:%M}",
		"tooltip-format": "<tt>{calendar}</tt>",
		"calendar": {
			"mode"          : "month",
			"mode-mon-col"  : 3,
			"on-scroll"     : 1,
			"format": {
				"months":     "<span color='#99ffdd'><b>{}</b></span>",
				"days":      "<span color='#ffffff'><b>{}</b></span>",
				"weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
				"today":      "<span color='#ff6699'><big><b>{}</b></big></span>"
			}
		},
		"actions":  {
			"on-click-right": "mode",
			"on-scroll-up": "shift_up",
			"on-scroll-down": "shift_down"
		}
	},
	"custom/power-menu": {
		"format": "",
		"tooltip-format": "Power Menu",
		"on-click": "rofi -show power -modes \"power:~/.config/rofi/power.zsh\""
	},

	"group/audio_source": {
		"orientation": "inherit",
		"modules": [
			"pulseaudio#source",
			"pulseaudio/slider#source",
		 ],
		 "drawer": {
			"transition-left-to-right": false,
		 },
	},
	"group/audio_sink": {
		"orientation": "inherit",
		"modules": [
			"pulseaudio#sink",
			"pulseaudio/slider#sink",
		 ],
		 "drawer": {
			"transition-left-to-right": false,
		 },
	},
	"keyboard-state": {
		"numlock": true,
		"capslock": true,
		"format": {
			"capslock": "󰪛 {icon}",
			"numlock": "󰎠 {icon}"
		},
		"format-icons": {
			"locked": "",
			"unlocked": ""
		}
	},
	"network": {
		"format-wifi": "{essid} ({signalStrength}%) ",
		"format-ethernet": "{ipaddr}/{cidr} ",
		"tooltip-format": "{ifname} via {gwaddr} ",
		"format-linked": "{ifname} (No IP) ",
		"format-disconnected": "Disconnected ⚠",
		"format-alt": "{ifname}: {ipaddr}/{cidr}"
	},
	"niri/workspaces": {
		"format": "{value}",
	},
	"pulseaudio#source": {
		"format": "{format_source}",
		"format-source": "{volume}% ",
		"format-source-muted": "",
		"on-click": "pkill pavucontrol || pavucontrol -t 4"
	},
	"pulseaudio/slider#source": {
		"target": "source",
		"min": 0,
		"max": 100,
		"orientation": "horizontal"
	},
	"pulseaudio#sink": {
		"format": "{volume}% {icon}",
		"format-muted": " {format_source}",
		"format-icons": {
			"headphone": "",
			"hands-free": "",
			"headset": "",
			"phone": "",
			"portable": "",
			"car": "",
			"default": ["", "", ""]
		},
		"on-click": "pkill pavucontrol || pavucontrol -t 3"
	},
	"pulseaudio/slider#sink": {
		"target": "sink",
		"min": 0,
		"max": 100,
		"orientation": "horizontal"
	},
	"tray": {
		"spacing": 10
	},
}
