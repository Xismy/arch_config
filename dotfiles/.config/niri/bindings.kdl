binds {
	// We use slightly modified defaults:
	// https://niri-wm.github.io/niri/Getting-Started.html#main-default-hotkeys
	// (*) If a hotkey switches somewhere, then adding Ctrl will move the focused window or column there.
	Mod+Shift+Slash { show-hotkey-overlay; }
	Mod+T hotkey-overlay-title="Terminal" { spawn "kitty"; }
	Mod+D hotkey-overlay-title="Run" { spawn-sh "pkill -USR1 fuzzel || fuzzel"; }
	Mod+Alt+L hotkey-overlay-title="Lock screen" { spawn "swaylock" "--color" "00a070"; }
	Mod+Q { close-window; }
	MouseBack { close-window; } //Non default. Added to close with mouse (no-csd).
	Mod+Left { focus-column-left; }
	Mod+Down { focus-window-down; }
	Mod+Up { focus-window-up; }
	Mod+Right { focus-column-right; }
	Mod+H { focus-column-left; }
	Mod+J { focus-window-down; }
	Mod+K { focus-window-up; }
	Mod+L { focus-column-right; }
	Mod+Ctrl+Left { move-column-left; }
	Mod+Ctrl+Down { move-window-down; }
	Mod+Ctrl+Up { move-window-up; }
	Mod+Ctrl+Right { move-column-right; }
	Mod+Ctrl+H { move-column-left; }
	Mod+Ctrl+J { move-window-down; }
	Mod+Ctrl+K { move-window-up; }
	Mod+Ctrl+L { move-column-right; }
	Mod+Shift+H { focus-monitor-left; }
	Mod+Shift+J { focus-monitor-down; }
	Mod+Shift+K { focus-monitor-up; }
	Mod+Shift+L { focus-monitor-right; }
	Mod+Ctrl+Shift+H { move-column-to-monitor-left; }
	Mod+Ctrl+Shift+J { move-column-to-monitor-down; }
	Mod+Ctrl+Shift+K { move-column-to-monitor-up; }
	Mod+Ctrl+Shift+L { move-column-to-monitor-right; }
	Mod+I { focus-workspace-up; }
	Mod+U { focus-workspace-down; }
	Mod+Prior { focus-workspace-up; }
	Mod+Next { focus-workspace-down; }
	Mod+Ctrl+I { move-column-to-workspace-up; }
	Mod+Ctrl+U { move-column-to-workspace-down; }
	Mod+Ctrl+Prior { move-column-to-workspace-up; }
	Mod+Ctrl+Next { move-column-to-workspace-down; }
	Mod+Shift+I { move-workspace-up; }
	Mod+Shift+U { move-workspace-down; }
	Mod+Shift+Prior { move-workspace-up; }
	Mod+Shift+Next { move-workspace-down; }
	Mod+Comma { consume-window-into-column; }
	Mod+Period { expel-window-from-column; }
	Mod+Bracketleft { consume-or-expel-window-left; }
	Mod+Bracketright { consume-or-expel-window-right; }
	Mod+R { switch-preset-column-width; }
	Mod+Shift+R { switch-preset-window-height; } 
	Mod+Alt+R { switch-preset-column-width-back; } // Non default. 
	Mod+Shift+Alt+R { switch-preset-window-height-back; } //Non default.
	Mod+F { maximize-column; }
	Mod+C { center-column; }
	Mod+Minus { set-column-width "-1%"; } // Default is 10%
	Mod+Equal { set-column-width "+1%"; } // Default is 10%
	Mod+Shift+Minus { set-window-height "-1%"; } // Default is 10%
	Mod+Shift+Equal { set-window-height "+1%"; } // Default is 10%
	Mod+Ctrl+R { reset-window-height; }
	Mod+Shift+F { fullscreen-window; }
	Mod+V { switch-focus-between-floating-and-tiling; } // Non default. Adapted to match (*).
	Mod+Ctrl+V { toggle-window-floating; } // Non default. Adapted to match (*).
	Mod+Shift+S hotkey-overlay-title="Screenshot" { // Non default. Non integrated alternative.
		spawn-sh "slurp | grim -g - - | satty -f- --copy-command=wl-copy"; 
	}
	Mod+Shift+E hotkey-overlay-title="Turn off" { // Non integrated alternative.
		spawn "qs" "ipc" "call" "dialog" "showPowerBar"; 
	}
	// End of (almost) defaults

	//Tools
	Mod+Shift+V hotkey-overlay-title="Clipboard history" { 
		spawn-sh "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; 
	}
	Mod+Shift+P { power-off-monitors; }
	Mod+Shift+O { toggle-window-rule-opacity; }
	Mod+Shift+Tab { open-overview; }

	// App shortcuts
	Mod+grave hotkey-overlay-title="Quake terminal" { spawn-sh "kitten quick-access-terminal"; }

	// Workspaces focus (idx based)
	Mod+1 { focus-workspace 1; }
	Mod+2 { focus-workspace 2; }
	Mod+3 { focus-workspace 3; }
	Mod+4 { focus-workspace 4; }
	Mod+5 { focus-workspace 5; }
	Mod+6 { focus-workspace 6; }
	Mod+7 { focus-workspace 7; }
	Mod+8 { focus-workspace 8; }
	Mod+9 { focus-workspace 9; }

	// Column move to workspace (idx based)
	Mod+Ctrl+1 { move-column-to-workspace 1; }
	Mod+Ctrl+2 { move-column-to-workspace 2; }
	Mod+Ctrl+3 { move-column-to-workspace 3; }
	Mod+Ctrl+4 { move-column-to-workspace 4; }
	Mod+Ctrl+5 { move-column-to-workspace 5; }
	Mod+Ctrl+6 { move-column-to-workspace 6; }
	Mod+Ctrl+7 { move-column-to-workspace 7; }
	Mod+Ctrl+8 { move-column-to-workspace 8; }
	Mod+Ctrl+9 { move-column-to-workspace 9; }
}
